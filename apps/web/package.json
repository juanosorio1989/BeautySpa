{
  "name": "@beautyspa/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev -p 3000",
    "build": "NODE_ENV=production dotenv -e ../../.env -- next build",
    "start": "NODE_ENV=production dotenv -e ../../.env -- next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "dotenv -e ../../.env -- bash -c './e2e/prepare.sh && playwright test'"
  },
  "dependencies": {
    "@beautyspa/api-client": "workspace:*",
    "@beautyspa/contracts": "workspace:*",
    "@beautyspa/datetime": "workspace:*",
    "@beautyspa/i18n": "workspace:*",
    "clsx": "^2.1.1",
    "next": "^16.4.6",
    "next-intl": "^4.15.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@beautyspa/config": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "dotenv-cli": "^7.4.0",
    "eslint": "^9.12.0",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
