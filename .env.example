DATABASE_URL=postgresql://beautyspa:beautyspa@localhost:5432/beautyspa
DATABASE_URL_TEST=postgresql://beautyspa:beautyspa@localhost:5432/beautyspa_test
REDIS_URL=redis://localhost:6379
# Integration tests FLUSHDB this one: never DB 0 or the REDIS_URL database
REDIS_URL_TEST=redis://localhost:6379/1
WEB_ORIGIN=http://localhost:3000
PORT=3001

# Web (apps/web, Next.js): API_URL is used server-side, NEXT_PUBLIC_* is exposed to the browser
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development
# Optional: shadow database for the drift check (default: DATABASE_URL_TEST + "_shadow")
# SHADOW_DATABASE_URL=postgresql://beautyspa:beautyspa@localhost:5432/beautyspa_test_shadow

# Single-tenant MVP: the organization every request belongs to (seeded by db:seed)
DEFAULT_ORG_SLUG=demo-salon

# Secrets: run pnpm --filter @beautyspa/api secrets:gen (fills empty values in .env, prints key names only)
JWT_PRIVATE_KEY_B64=
DATA_ENCRYPTION_KEY=
# HMAC key for customer manage links (base64, at least 32 bytes); required in every environment
MANAGE_LINK_SECRET=
# JWT_KEY_ID=k1
# DATA_ENCRYPTION_KEY_ID=k1

# Cookies / proxy (COOKIE_SECURE defaults to true only in production)
# COOKIE_SECURE=false
# COOKIE_DOMAIN=
# TRUST_PROXY: false (default) | hop count | comma-separated proxy IPs/CIDRs; use 1 on Railway/Fly.
# "true" is rejected: it would trust a client-forged X-Forwarded-For and bypass per-IP rate limits.
# TRUST_PROXY=false

# Hold sweeper: releases expired booking holds every N ms in the API process (0 disables; default 60000)
# HOLD_SWEEP_INTERVAL_MS=60000

# OTP: console (logs codes) | twilio (required in production) | fake (tests only)
OTP_PROVIDER=console
# OTP channels tried in order: whatsapp | sms (default sms; WhatsApp waits until it is enabled on the Verify service)
# OTP_CHANNELS=sms
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# Email: console | resend (required in production)
EMAIL_PROVIDER=console
# RESEND_API_KEY=
# EMAIL_FROM=BeautySpa <no-reply@example.com>

# Push: console (logs) | webpush (required in production) | fake (tests only)
PUSH_PROVIDER=console
# VAPID pair (base64url): secrets:gen fills both only when both are empty; required with webpush
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, mailto: or https: (required with webpush)
# VAPID_SUBJECT=mailto:owner@example.com

# Reminder scan: worker looks for due 24 h / 2 h reminders every N ms (0 disables; default 60000)
# REMINDER_SCAN_INTERVAL_MS=60000
